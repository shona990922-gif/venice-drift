{
  "name": "venice-drift",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "build:city": "node scripts/build-city.mjs",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write src tests scripts *.ts *.js *.html"
  },
  "dependencies": {
    "@takustaqu/atmosphere": "0.3.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.185.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "meshoptimizer": "^1.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
